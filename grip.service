[Unit]
Description=GRIP personal publishing server
Documentation=https://github.com/woollover/grip
After=network.target

[Service]
Type=simple
User=grip
Group=grip
WorkingDirectory=/opt/grip
ExecStart=/opt/grip/grip serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grip

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/grip/data /opt/grip/media

[Install]
WantedBy=multi-user.target
